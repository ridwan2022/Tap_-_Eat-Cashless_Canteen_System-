<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TapAndEat.Api</RootNamespace>
    <UserSecretsId>tapandeat-sprint1</UserSecretsId>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Sprint 1 deliberately depends on nothing outside the ASP.NET Core shared
    framework (Microsoft.AspNetCore.App): no EF Core, no JWT package, no test
    package. That keeps the project buildable/runnable offline with just the
    .NET 8 SDK. See README.md "Sprint 2 upgrade path" for how to swap the
    in-memory repositories for EF Core + SQL Server and JWT once the team
    provisions those.
  -->

</Project>
