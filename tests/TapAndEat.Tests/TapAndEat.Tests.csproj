<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TapAndEat.Tests</RootNamespace>
  </PropertyGroup>

  <!--
    This is a lightweight, hand-rolled test runner rather than xUnit: this
    sandbox has no internet access to restore the xunit / Microsoft.NET.Test.Sdk
    NuGet packages. On a machine with normal NuGet access, replace this
    project with a standard xUnit test project — the individual test methods
    below are already written as small, independent, arrange/act/assert
    functions and translate to [Fact] methods almost mechanically.
  -->

  <ItemGroup>
    <ProjectReference Include="..\..\src\TapAndEat.Api\TapAndEat.Api.csproj" />
    <!-- Explicit rather than relying on transitive propagation from the
         referenced Sdk.Web project, so this project resolves ASP.NET Core
         types (ILogger<T>, IHubContext<T>, IPasswordHasher<T>) directly. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
